# --- Hindsight ---
# Cloud: sign up at https://ui.hindsight.vectorize.io, apply promo code MEMHACK99
# in the billing section AFTER registering, then copy your API key here.
# Self-hosted (local Docker): use http://localhost:8888 and leave the key blank.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=

# --- LLM provider (Hindsight uses this under the hood for reflect()/extraction) ---
# Get a free key at https://groq.com/. Where exactly this gets wired up (Hindsight
# Cloud project settings vs. an env var here) depends on what the Hindsight Cloud
# dashboard shows once you're signed in — check config/hindsight.js for the note.
GROQ_API_KEY=

# --- Server ---
PORT=4000
